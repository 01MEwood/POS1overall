# DataForSEO-Zugangsdaten (https://app.dataforseo.com/api-access)
# Ohne diese Werte läuft die App im Demo-Modus mit gekennzeichneten Beispieldaten.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Optional
# PORT=5317                 # Backend-Port
# DATA_DIR=./data           # Ablageort der SQLite-Datenbank
# DFS_LOCATION_CODE=2276    # 2276 = Deutschland
# DFS_LANGUAGE_CODE=de
